FROM nginx:1.28-alpine
COPY deployment/nginx-homepage.conf /etc/nginx/conf.d/default.conf
COPY site/ /usr/share/nginx/html/
COPY index.html /usr/share/nginx/html/editor/index.html
COPY assets/ /usr/share/nginx/html/editor/assets/
COPY LICENSE /usr/share/nginx/html/LICENSE
COPY deployment/standalone-guard.js /usr/share/nginx/html/editor/standalone-guard.js
# 기존 EMM 배포용 원본은 보존하고 독립 웹 서비스 사본에만 보호 스크립트 삽입
RUN awk '/<head>/{print; print "<script>"; while ((getline line < "/usr/share/nginx/html/editor/standalone-guard.js") > 0) print line; print "</script>"; next} {print}' /usr/share/nginx/html/editor/index.html > /tmp/editor.html \
    && mv /tmp/editor.html /usr/share/nginx/html/editor/index.html \
    && mkdir -p /usr/share/nginx/html/downloads \
    && cp /usr/share/nginx/html/editor/index.html /usr/share/nginx/html/downloads/markdown-editor.html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
