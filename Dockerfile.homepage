FROM node:24-alpine AS offline
WORKDIR /src
COPY index.html /src/index.html
COPY assets/logo.svg /src/assets/logo.svg
COPY desktop/source/vendor-manifest.json /src/desktop/source/vendor-manifest.json
COPY deployment/build-offline-download.cjs /src/deployment/build-offline-download.cjs
RUN node /src/deployment/build-offline-download.cjs /out

FROM nginx:1.28-alpine
COPY deployment/nginx-homepage.conf /etc/nginx/conf.d/default.conf
COPY site/ /usr/share/nginx/html/
COPY index.html /usr/share/nginx/html/editor/index.html
COPY assets/ /usr/share/nginx/html/editor/assets/
COPY LICENSE /usr/share/nginx/html/LICENSE
COPY deployment/standalone-guard.js /usr/share/nginx/html/editor/standalone-guard.js
COPY --from=offline /out/markdown-editor.html /usr/share/nginx/html/downloads/markdown-editor.html
COPY --from=offline /out/markdown-editor.build.json /usr/share/nginx/html/downloads/markdown-editor.build.json
# EMM 공통 원본은 그대로 두고 웹 서비스와 오프라인 다운로드 사본에만 보호 코드 삽입
RUN set -eu; for file in /usr/share/nginx/html/editor/index.html /usr/share/nginx/html/downloads/markdown-editor.html; do \
    awk '/<script id="appMain">/{inmain=1} {print} inmain && /^"use strict";/{while ((getline line < "/usr/share/nginx/html/editor/standalone-guard.js") > 0) print line; inmain=0}' "$file" > /tmp/editor.html; \
    mv /tmp/editor.html "$file"; \
    done
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
